{
  "name": "University Management System",
  "version": "1.0.0",
  "description": "Complete University Management System with MERN Stack",
  "author": "UMS Development Team",
  "features": {
    "backend": [
      "Complete REST API with Express.js",
      "MongoDB database with Mongoose ODM",
      "Student Management System",
      "Course Management System",
      "Staff Management System",
      "Room Booking Management",
      "Enrollment Management",
      "Timetable/Schedule Management",
      "Dashboard Analytics",
      "Error Handling Middleware",
      "CORS Support",
      "Relationship Management (References)"
    ],
    "frontend": [
      "React with React Router",
      "Dashboard with Statistics",
      "Student Management UI",
      "Course Management UI",
      "Staff Management UI",
      "Room Management UI",
      "Enrollment Management UI",
      "Timetable Management UI",
      "CRUD Operations for all entities",
      "Modern UI with CSS Styling",
      "Responsive Design",
      "Navigation System"
    ],
    "database": [
      "Student Model with complete fields",
      "Course Model with instructor references",
      "Staff Model with department tracking",
      "Room Model with booking system",
      "Enrollment Model for student-course relationships",
      "Timetable Model for scheduling",
      "Timestamps on all models",
      "Unique constraints on IDs and emails"
    ]
  },
  "api_endpoints": {
    "students": [
      "GET /api/students",
      "GET /api/students/:id",
      "POST /api/students",
      "PATCH /api/students/:id",
      "DELETE /api/students/:id"
    ],
    "courses": [
      "GET /api/courses",
      "GET /api/courses/:id",
      "POST /api/courses",
      "PATCH /api/courses/:id",
      "DELETE /api/courses/:id"
    ],
    "staff": [
      "GET /api/staff",
      "GET /api/staff/:id",
      "POST /api/staff",
      "PATCH /api/staff/:id",
      "DELETE /api/staff/:id"
    ],
    "rooms": [
      "GET /api/rooms",
      "GET /api/rooms/:id",
      "POST /api/rooms",
      "PATCH /api/rooms/:id",
      "DELETE /api/rooms/:id"
    ],
    "enrollments": [
      "GET /api/enrollments",
      "GET /api/enrollments/student/:studentId",
      "POST /api/enrollments",
      "PATCH /api/enrollments/:id",
      "DELETE /api/enrollments/:id"
    ],
    "timetables": [
      "GET /api/timetables",
      "GET /api/timetables/course/:courseId",
      "GET /api/timetables/room/:roomId",
      "POST /api/timetables",
      "PATCH /api/timetables/:id",
      "DELETE /api/timetables/:id"
    ],
    "dashboard": [
      "GET /api/dashboard"
    ]
  },
  "models": {
    "Student": {
      "fields": [
        "studentId (unique)",
        "firstName",
        "lastName",
        "email (unique)",
        "phone",
        "dateOfBirth",
        "address",
        "department",
        "enrollmentDate",
        "status (Active/Inactive/Graduated)",
        "gpa",
        "enrolledCourses (references)"
      ]
    },
    "Course": {
      "fields": [
        "code (unique)",
        "title",
        "description",
        "credits",
        "type (Core/Elective)",
        "department",
        "instructor (reference)",
        "capacity",
        "enrolledStudents",
        "semester",
        "prerequisites"
      ]
    },
    "Staff": {
      "fields": [
        "staffId (unique)",
        "firstName",
        "lastName",
        "email (unique)",
        "phone",
        "department",
        "officeLocation",
        "officeHours",
        "role (Professor/Associate Professor/TA/Admin)",
        "qualification",
        "hireDate",
        "coursesTaught (references)",
        "status (Active/Inactive/Leave)"
      ]
    },
    "Room": {
      "fields": [
        "roomNumber (unique)",
        "building",
        "floor",
        "capacity",
        "type (Classroom/Lab/Auditorium/Seminar)",
        "facilities",
        "isAvailable",
        "bookings (array of booking objects)"
      ]
    },
    "Enrollment": {
      "fields": [
        "student (reference)",
        "course (reference)",
        "enrollmentDate",
        "grade (A/B/C/D/F/Pending)",
        "attendance",
        "status (Active/Dropped/Completed)"
      ]
    },
    "Timetable": {
      "fields": [
        "course (reference)",
        "instructor (reference)",
        "room (reference)",
        "dayOfWeek (Monday-Friday)",
        "startTime",
        "endTime",
        "semester",
        "capacity"
      ]
    }
  },
  "technologies": {
    "backend": [
      "Node.js",
      "Express.js",
      "MongoDB",
      "Mongoose",
      "CORS",
      "Dotenv"
    ],
    "frontend": [
      "React",
      "React Router DOM",
      "CSS3",
      "JavaScript ES6+"
    ]
  },
  "file_structure": {
    "backend": {
      "models": "6 database models",
      "routes": "7 route files with full CRUD",
      "server.js": "Main server entry point"
    },
    "frontend": {
      "pages": "7 management pages",
      "App.js": "Main app with routing",
      "App.css": "Global styles",
      "index.js": "React entry point"
    }
  }
}
